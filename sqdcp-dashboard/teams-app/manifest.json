      "websiteUrl": "https://app.powerbi.com/groups/{{WORKSPACE_ID}}/reports/{{REPORT_ID}}",
      "scopes": ["personal"]
    },
    {
      "entityId": "about",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["app.powerbi.com", "*.powerbi.com"]
