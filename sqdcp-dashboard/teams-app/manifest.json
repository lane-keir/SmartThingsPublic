  "developer": {
    "name": "{{COMPANY_NAME}} Operations Excellence",
    "websiteUrl": "https://app.powerbi.com",
    "privacyUrl": "https://app.powerbi.com",
    "termsOfUseUrl": "https://app.powerbi.com"
  },
  "name": {
    "short": "SQDCP Start of Shift",
    "full": "SQDCP Start of Shift Dashboard"
  },
  "description": {
    "short": "Safety, Quality, Delivery, Cost and People for the morning start-of-shift meeting.",
    "full": "Tier 1 start-of-shift board: yesterday's SQDCP performance against target, month-to-date letter calendars, trends, drill-through to the originating EHS, QMS, MES, andon and ERP records, and the open action log. Data is refreshed from the source systems by Power BI before each shift."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#263238",
